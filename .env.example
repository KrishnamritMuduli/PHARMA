# ==============================================================================
# PharmaPulse Environment Configuration Template
# Duplicate this file as .env or set these in your Vercel Project Settings
# ==============================================================================

# Database Connection URL:
# 1. For Local Development with SQLite:
DATABASE_URL="file:./dev.db"

# 2. For Production on Vercel with PostgreSQL (Vercel Postgres, Neon, Supabase, Railway):
# (Run `npm run db:postgres` before pushing to Vercel so Prisma targets PostgreSQL)
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session & Access Tokens:
JWT_SECRET="replace-with-a-random-secure-32-char-string-in-production"

# Port (Optional, defaults to 3000):
PORT=3000
